type hal_cryptoeng_default, domain;
binder_use(hal_cryptoeng_default)
hal_server_domain(hal_cryptoeng_default, hal_cryptoeng)

type hal_cryptoeng_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_cryptoeng_default)

add_hwservice(hal_cryptoeng_server, hal_cryptoeng_hwservice)
allow hal_cryptoeng_client hal_cryptoeng_hwservice:hwservice_manager find;

binder_call(hal_cryptoeng_client, hal_cryptoeng_server)
hal_attribute_service(hal_cryptoeng, hal_cryptoeng_service)

allow hal_cryptoeng_default ion_device:chr_file rw_file_perms;
allow hal_cryptoeng_default self:qipcrtr_socket create;
allow hal_cryptoeng_default tee_device:chr_file rw_file_perms;
allow hal_cryptoeng_default hal_cryptoeng_default:socket create;

r_dir_file(hal_cryptoeng, firmware_file)

allow hal_cryptoeng_default vendor_qce_device:chr_file rw_file_perms;
allow hal_cryptoeng_default self:qipcrtr_socket { read write getattr setopt };

# Keybox and per-user state
allow hal_cryptoeng_default cryptoeng_data_file:dir create_dir_perms;
allow hal_cryptoeng_default cryptoeng_data_file:file create_file_perms;
allow tee cryptoeng_data_file:dir create_dir_perms;
allow tee cryptoeng_data_file:file create_file_perms;
allow hal_cryptoeng_default vendor_data_file:dir create_dir_perms;
allow hal_cryptoeng_default vendor_data_file:file create_file_perms;

# Licenses and provisioning data on persist
allow hal_cryptoeng_default mnt_vendor_file:dir search;
allow hal_cryptoeng_default vendor_persist_data_file:dir rw_dir_perms;
allow hal_cryptoeng_default vendor_persist_data_file:file create_file_perms;
allow hal_cryptoeng_default oppo_reserve_file:dir rw_dir_perms;
allow hal_cryptoeng_default oppo_reserve_file:file create_file_perms;

allow hal_cryptoeng_default sysfs:file rw_file_perms;
r_dir_file(hal_cryptoeng_default, vendor_proc_oppo_secure_common_file)

binder_call(hal_cryptoeng_default, hal_drm_widevine)
binder_call(hal_cryptoeng_default, system_server)
binder_call(hal_cryptoeng_default, vendor_hal_qteeconnector_qti)
binder_call(hal_cryptoeng_default, vendor_hal_soter_qti)
allow hal_cryptoeng_default vendor_hal_soter_hwservice:hwservice_manager find;
hal_client_domain(hal_cryptoeng_default, vendor_hal_oplus_commondcs)

set_prop(hal_cryptoeng_default, vendor_oplus_cryptoeng_prop)
get_prop(hal_cryptoeng_default, boot_status_prop)
allow hal_cryptoeng_default hal_oplus_olc_aidl_service:service_manager find;
