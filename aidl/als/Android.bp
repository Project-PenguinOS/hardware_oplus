// libgui has no Rust bindings; the display queries and the capture itself are in C++.
cc_library_static {
    name: "libals_capture",
    system_ext_specific: true,
    srcs: ["capture.cpp"],
    export_include_dirs: ["."],
    shared_libs: [
        "libbinder",
        "libgui",
        "liblog",
        "libui",
        "libutils",
    ],
}

rust_defaults {
    name: "vendor.lineage.oplus_als.service-defaults",
    system_ext_specific: true,
    prefer_rlib: true,
    srcs: ["main.rs"],
    rustlibs: [
        "libbinder_rs",
        "liblog_rust",
        "liblogger",
        "librustutils",
        "libserde_json",
        "vendor.lineage.oplus_als-V1-rust",
    ],
    static_libs: ["libals_capture"],
    shared_libs: [
        "libc++",
        "libbinder",
        "libgui",
        "liblog",
        "libui",
        "libutils",
    ],
}

rust_binary {
    name: "vendor.lineage.oplus_als.service",
    defaults: ["vendor.lineage.oplus_als.service-defaults"],
    init_rc: ["vendor.lineage.oplus_als.service.rc"],
    vintf_fragments: ["vendor.lineage.oplus_als.service.xml"],
    relative_install_path: "hw",
}

rust_test {
    name: "vendor.lineage.oplus_als.service-test",
    defaults: ["vendor.lineage.oplus_als.service-defaults"],
    test_suites: ["general-tests"],
}

cc_test {
    name: "oplus_als_capture_listener_test",
    system_ext_specific: true,
    srcs: ["capture_listener_test.cpp"],
    shared_libs: ["libbinder", "libgui", "libui", "libutils"],
    test_suites: ["general-tests"],
}
